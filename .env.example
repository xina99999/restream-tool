# Copy this file to .env and add your deployment values. Never commit .env.
RESTREAM_USERNAME=your-rtsp-username
RESTREAM_PASSWORD=your-rtsp-password

# Absolute host directory containing videos to scan.
RESTREAM_VIDEO_LIBRARY_DIR=/home/your-user/videos

# Required only when using s3://bucket/key. Presigned HTTPS URLs need none of these.
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
